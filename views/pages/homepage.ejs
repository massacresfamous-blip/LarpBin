<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/header') %>
</head>

<body>
    <%- include('../partials/header') %>

        <% if (loggedIn==true) { %>
            <!-- Logged in -->
            <nav class="navbar navbar-inverse">
                <div class="container-fluid">
                    <div class="navbar-header">
                        <a class="navbar-brand" href="/">BREACH BIN</a>
                    </div>
                    <ul class="nav navbar-nav">
                        <li><a href="/">Home</a></li>
                        <li><a href="/newpaste">New Paste</a></li>
                        <li><a href="/users">Users</a></li>
                        <li><a href="/">Upgrades</a></li>
                        <li><a href="/">Wall of Clowns</a></li>
                        <li class="dropdown">
                            <a class="dropdown-toggle" data-toggle="dropdown" href="/">About
                                <span class="caret"></span>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a href="/">FAQ</a></li>
                                <li><a href="/">Donate</a></li>
                                <li><a href="/">Prices</a></li>
                                <li><a href="/">Contact</a></li>
                            </ul>
                        </li>
                    </ul>
                    <ul class="nav navbar-nav navbar-right">
                        <li><a href="/profile?uid=<%= user.id %>">Profile</a></li>
                        <li><a href="/login/logout">Logout</a></li>
                    </ul>
                </div>
            </nav>
            <% } else { %>
                <!-- Not logged in -->
                <nav class="navbar navbar-inverse">
                    <div class="container-fluid">
                        <div class="navbar-header">
                            <a class="navbar-brand" href="/">BREACH BIN</a>
                        </div>
                        <ul class="nav navbar-nav">
                            <li><a href="/">Home</a></li>
                            <li><a href="/newpaste">New Paste</a></li>
                            <li><a href="/users">Users</a></li>
                            <li><a href="/upgrade">Upgrades</a></li>
                            <li><a href="/wallofclowns">Wall of Clowns</a></li>
                            <li class="dropdown">
                                <a class="dropdown-toggle" data-toggle="dropdown" href="/">About
                                    <span class="caret"></span>
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a href="/faq.php">FAQ</a></li>
                                    <li><a href="/viewpaste.php?id=55038">ToS</a></li>
                                    <li><a href="/viewpaste.php?id=29175">Changelog</a></li>
                                    <li><a href="/donate.php">Donate</a></li>
                                    <li><a href="/prices.php">Prices</a></li>
                                    <li><a href="/contact.php">Contact</a></li>
                                </ul>
                            </li>
                        </ul>
                        <ul class="nav navbar-nav navbar-right">
                            <li><a href="/signup">Register</a></li>
                            <li><a href="/login">Login</a></li>
                        </ul>
                    </div>
                </nav>
                <% } %>


                    <div class="container">
                        <div class="col-lg-12 col-md-12 col-12"><br>
                        </div>
                    </div>

                    <div class="text-center">
                        <pre class="ascii-logo"><%= logoText %></pre>
                        <h4><b><a class="text-center-color"
                                    href="https://www.youtube.com/watch?v=xvFZjo5PgG0&pp=ygUJcmljayByb2xs"
                                    rel="norefferer" target="_blank">Official
                                    BreachBin
                                    Telegram</a></b></h4><br>
                    </div>

                    <div class="div-center">
                        <form id="search-form" method="GET" action="/search">
                            <input name="query" type="text" placeholder="Search for.." value="">
                            <input type="hidden" name="type" value="posts"> <!-- Predefined type -->
                            <input type="submit" value="Search">
                        </form>
                    </div>


                    <div class="container">
                        <div class="col-lg-12 col-md-12 col-12"><br>
                        </div>
                    </div>

                    <div class="container">
                        <table class="table table-hover">
                            <thead class="tb-highlight">
                                <tr>
                                    <th>Title</th>
                                    <th>Made by</th>
                                    <th>File Size</th>
                                    <th>Comments</th>
                                    <th>Views</th>
                                    <th>Date created</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Pinned Pastes Section -->
                                <% pastes.filter(p=> p.pinned).forEach(paste => { %>
                                    <tr class="paste-item <%= paste.post_type %>">
                                        <td>
                                            <a class="paste-link" href="/paste?id=<%= paste.id %>" target="_blank"
                                                title="<%= paste.title %>"
                                                style="color: <%= paste.text_color %> !important; font-weight: bold;">
                                                <%= paste.title %>
                                            </a>
                                        </td>
                                        <td><a class="paste-link <%= paste.post_type %>"
                                                href="/profile?uid=<%= paste.user_id %>" target="_blank"
                                                style="color: <%= paste.text_color %> !important;">
                                                <%= paste.user_name %>
                                            </a></td>
                                        <td style="color: <%= paste.text_color %> !important;">
                                            <%= paste.content_size %> bytes
                                        </td>
                                        <td style="color: <%= paste.text_color %> !important;">
                                            <%= paste.comments_count %>
                                        </td>
                                        <td style="color: <%= paste.text_color %> !important;">
                                            <%= paste.views_count %>
                                        </td>
                                        <td style="color: <%= paste.text_color %> !important;">
                                            <%= paste.created_at %>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <!-- Regular Pastes Section -->
                                        <% pastes.filter(p=> !p.pinned).forEach(paste => { %>
                                            <tr class="paste-item <%= paste.post_type %>">
                                                <td><a class="paste-link" href="/paste?id=<%= paste.id %>"
                                                        target="_blank" title="<%= paste.title %>"
                                                        style="color: <%= paste.text_color %> !important;">
                                                        <%= paste.title %>
                                                    </a></td>
                                                <td><a class="paste-link <%= paste.post_type %>"
                                                        href="/profile?uid=<%= paste.user_id %>" target="_blank"
                                                        style="color: <%= paste.text_color %> !important;">
                                                        <%= paste.user_name %>
                                                    </a></td>
                                                <td style="color: <%= paste.text_color %> !important;">
                                                    <%= paste.content_size %> bytes
                                                </td>
                                                <td style="color: <%= paste.text_color %> !important;">
                                                    <%= paste.comments_count %>
                                                </td>
                                                <td style="color: <%= paste.text_color %> !important;">
                                                    <%= paste.views_count %>
                                                </td>
                                                <td style="color: <%= paste.text_color %> !important;">
                                                    <%= paste.created_at %>
                                                </td>
                                            </tr>
                                            <% }) %>
                            </tbody>
                        </table>

                        <% if (totalPages> 1) { %>
                            <div class="pagination">
                                <% if (page> 1) { %>
                                    <a href="/?page=<%= page - 1 %>" class="page-btn">&lt;</a>
                                    <% } %>

                                        <% let startPage=Math.max(1, page - 2); let endPage=Math.min(totalPages,
                                            startPage + 4); if (endPage - startPage < 4) { startPage=Math.max(1, endPage
                                            - 4); } %>

                                            <% for (let i=startPage; i <=endPage; i++) { %>
                                                <a href="/?page=<%= i %>"
                                                    class="page-btn <%= i === page ? 'active' : '' %>">
                                                    <%= i %>
                                                </a>
                                                <% } %>

                                                    <% if (page < totalPages) { %>
                                                        <a href="/?page=<%= page + 1 %>" class="page-btn">&gt;</a>
                                                        <% } %>
                            </div>
                            <% } %>
                    </div>
                    </div>
                    <script src="/js/log.js"></script>
</body>

</html>