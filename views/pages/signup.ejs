    <div class="container">
        <div class="col-lg-12 col-md-12 col-12"><br>
        </div>
    </div>

    <div class="reglog-form">
        <form id="signupForm" action="/signup" method="POST">
            <label for="username">Username</label><br>
            <input type="text" name="username" placeholder="Username" required><br>
            <label for="email">This should mainly be used for emails however feel free to put whatever</label><br>
            <input type="text" name="email" placeholder="Email/XMPP" required><br>
            <label for="pwd">Password [ DONT FORGET ]</label><br>
            <input type="password" name="password" placeholder="Password" required><br>
            <label for="confirmpwd">Repeat Password</label><br>
            <input type="password" name="confirmpwd" placeholder="Repeat Password" required><br>

            <div class="h-captcha" data-sitekey="ca809027-c3cb-42b6-9dd8-31d626eaa472"></div>
            <br>

            <input type="submit" name="submit" value="Register">

            <p>Please make sure your username does not contain any special characters or spaces.</p>
            <p>We do no validation on emails/XMPP addresses, so feel free to enter whatever you want.</p>
            <p>Please remember your password; if you forget it, you might have to pay a fine to get it reset.</p>
        </form>
    </div>

    <script src="https://hcaptcha.com/1/api.js" async defer></script>
    <script>
        document.getElementById('signupForm').addEventListener('submit', function (event) {
            var captchaResponse = document.querySelector('textarea[name="h-captcha-response"]').value;
            if (!captchaResponse) {
                alert('Please complete the hCaptcha challenge.');
                event.preventDefault();
            }
        });
    </script>
    <script src="/js/log.js"></script>
</body>

