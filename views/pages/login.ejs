<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/header') %>
        <title>Login</title>
</head>

<body>

    <nav class="navbar navbar-inverse">
        <div class="container-fluid">
            <div class="navbar-header">
                <a class="navbar-brand" href="/">BREACH BIN</a>
            </div>
            <ul class="nav navbar-nav">
                <li><a href="/">Home</a></li>
                <li><a href="/newpaste">New Paste</a></li>
                <li><a href="/users">Users</a></li>
                <li><a href="/upgrades">Upgrades</a></li>
                <li><a href="/hoa">HOA</a></li>
                <li class="dropdown">
                    <a class="dropdown-toggle" data-toggle="dropdown" href="/faq">About
                        <span class="caret"></span></a>
                    <ul class="dropdown-menu">
                        <li><a href="/faq">FAQ</a></li>
                        <li><a href="/terms">Terms of Service</a></li>
                        <li><a href="/changelog">Changelog</a></li>
                        <li><a href="/donate">Donate</a></li>
                        <li><a href="/prices">Prices</a></li>
                        <li><a href="/contact">Contact</a></li>
                    </ul>
                </li>
            </ul>
            <ul class="nav navbar-nav navbar-right">
                <li><a href="/signup">Register</a></li>
                <li><a href="/login">Login</a></li>
            </ul>
        </div>
    </nav>

    <div class="container">
        <div class="col-lg-12 col-md-12 col-12"><br>
        </div>
    </div>

    <div class="reglog-form">
        <form id="loginForm" action="/login" method="POST">
            <label for="username">Username</label><br>
            <input type="text" name="username" placeholder="Username" required><br>
            <label for="password">Password</label><br>
            <input type="password" name="password" placeholder="Password" required><br>

            <div class="h-captcha" data-sitekey="ca809027-c3cb-42b6-9dd8-31d626eaa472"></div>
            <br>

            <input type="submit" name="submit" value="Login">
        </form>
    </div>

    <script src="https://hcaptcha.com/1/api.js" async defer></script>
    <script>
        document.getElementById('loginForm').addEventListener('submit', function (event) {
            var captchaResponse = document.querySelector('textarea[name="h-captcha-response"]').value;
            if (!captchaResponse) {
                alert('Please complete the hCaptcha challenge.');
                event.preventDefault();
            }
        });
    </script>
    <script src="/js/log.js"></script>
</body>

</html>