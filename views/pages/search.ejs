<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/header') %>
</head>

<body>
    <% if (loggedIn==true) { %>
        <!-- Logged in -->
        <nav class="navbar navbar-inverse">
            <div class="container-fluid">
                <div class="navbar-header">
                    <a class="navbar-brand" href="/">BREACH BIN</a>
                </div>
                <ul class="nav navbar-nav">
                    <li><a href="/">Home</a></li>
                    <li><a href="/newpaste">New Paste</a></li>
                    <li><a href="/users">Users</a></li>
                    <li><a href="/upgrades">Upgrades</a></li>
                    <li><a href="/hoa">HOA</a></li>
                    <li class="dropdown">
                        <a class="dropdown-toggle" data-toggle="dropdown" href="/faq">About
                            <span class="caret"></span>
                        </a>
                        <ul class="dropdown-menu">
                            <li><a href="/faq">FAQ</a></li>
                            <li><a href="/terms">Terms of Service</a></li>
                            <li><a href="/changelog">Changelog</a></li>
                            <li><a href="/donate">Donate</a></li>
                            <li><a href="/prices">Prices</a></li>
                            <li><a href="/contact">Contact</a></li>
                        </ul>
                    </li>
                </ul>
                <ul class="nav navbar-nav navbar-right">
                    <li><a href="/settings">Settings</a></li>
                    <li><a href="/profile?uid=<%= user.id %>">Profile</a></li>
                    <li><a href="/login/logout">Logout</a></li>
                </ul>
            </div>
        </nav>
        <% } else { %>
            <!-- Not logged in -->
            <nav class="navbar navbar-inverse">
                <div class="container-fluid">
                    <div class="navbar-header">
                        <a class="navbar-brand" href="/">BREACH BIN</a>
                    </div>
                    <ul class="nav navbar-nav">
                        <li><a href="/">Home</a></li>
                        <li><a href="/newpaste">New Paste</a></li>
                        <li><a href="/users">Users</a></li>
                        <li><a href="/upgrades">Upgrades</a></li>
                        <li><a href="/hoa">HOA</a></li>
                        <li class="dropdown">
                            <a class="dropdown-toggle" data-toggle="dropdown" href="/faq">About
                                <span class="caret"></span>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a href="/faq">FAQ</a></li>
                                <li><a href="/terms">Terms of Service</a></li>
                                <li><a href="/changelog">Changelog</a></li>
                                <li><a href="/donate">Donate</a></li>
                                <li><a href="/prices">Prices</a></li>
                                <li><a href="/contact">Contact</a></li>
                            </ul>
                        </li>
                    </ul>
                    <ul class="nav navbar-nav navbar-right">
                        <li><a href="/signup">Register</a></li>
                        <li><a href="/login">Login</a></li>
                    </ul>
                </div>
            </nav>
            <% } %>


                <div class="container">
                    <div class="col-lg-12 col-md-12 col-12"><br>
                    </div>
                </div>

                <div class="text-center">
                    <pre class="ascii-logo"><%= logoText %></pre>
                    <h4><b><a class="text-center-color" href="https://t.me/skidbinsite" rel="norefferer"
                                target="_blank">Official
                                BreachBin
                                Telegram</a></b></h4><br>
                </div>

                <div class="div-center">
                    <form id="search-form" method="GET" action="/search">
                        <input name="query" type="text" placeholder="Search for.." value="">
                        <input type="hidden" name="type" value=<%=type %>> <!-- Predefined type -->
                        <input type="submit" value="Search">
                    </form>
                </div>


                <div class="container">
                    <div class="col-lg-12 col-md-12 col-12"><br>
                    </div>
                </div>
                <div class="container">
                    <% if (message) { %>
                        <p>
                            <%= message %>
                        </p>
                        <% } %>
                            <% if (type==='posts' ) { %>
                                <% if (pastes.length===0) { %>
                                    <% } else { %>
                                        <table class="table table-hover">
                                            <thead class="tb-highlight">
                                                <tr>
                                                    <th>Title</th>
                                                    <th>Made by</th>
                                                    <th>File Size</th>
                                                    <th>Date created</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% pastes.forEach(paste=> { %>
                                                    <tr>
                                                        <td><a style="color: <%= paste.text_color %>;"
                                                                href="/paste/<%= paste.id %>">
                                                                <%= paste.title %>
                                                            </a></td>
                                                        <td><a style="color: <%= paste.text_color %>;"
                                                                href="/profile/<%= paste.user_id %>">
                                                                <%= paste.user_name %>
                                                            </a></td>
                                                        <td style="color: <%= paste.text_color %> !important;">
                                                            <%= paste.content_size %> bytes
                                                        </td>
                                                        </td>
                                                        <td style="color: <%= paste.text_color %> !important;">
                                                            <%= paste.created_at %>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                            </tbody>
                                        </table>
                                        <% } %>
                                            <% } else if (type==='users' ) { %>
                                                <% if (users.length===0) { %>
                                                    <% } else { %>
                                                        <table class="table table-hover">
                                                            <thead class="tb-highlight">
                                                                <tr>
                                                                    <th>User ID</th>
                                                                    <th>Username</th>
                                                                    <th>Joined</th>
                                                                    <th>Paste Count</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <% users.forEach(user=> { %>
                                                                    <tr>
                                                                        <td>
                                                                            <%= user.id %>
                                                                        </td>
                                                                        <td><a href="/profile/<%= user.id %>">
                                                                                <%= user.username %>
                                                                            </a></td>
                                                                        <td>
                                                                            <%= user.created_at %>
                                                                        </td>
                                                                        <td>
                                                                            <%= user.paste_count %>
                                                                        </td>
                                                                        <!-- Assuming user has a paste_count property -->
                                                                    </tr>
                                                                    <% }) %>
                                                            </tbody>
                                                        </table>
                                                        <% } %>
                                                            <% } %>
                </div>
                <script src="/js/log.js"></script>
</body>

</html>